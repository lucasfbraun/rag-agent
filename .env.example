# Banco Vetorial Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Nome da coleção. Só mexa se estiver restaurando um snapshot que veio com
# outro nome (o Qdrant cria a coleção com o nome de ORIGEM e não renomeia), ou
# se dividir a mesma instância com outro projeto. Nome errado aqui não dá erro:
# a aplicação simplesmente reporta "base vetorial vazia".
COLLECTION_NAME=pu_products_catalog

# Chaves de API das IAs (preencher com valores reais em .env local, nunca commitar)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=

# Modelo de embedding usado no RAG (ingestão + busca).
#
# TEM QUE SER O MESMO na ingestão e na consulta, e VECTOR_SIZE tem que bater com
# a dimensão do modelo: trocar de modelo NÃO é editar uma variável — muda a
# dimensão do vetor e obriga a RECRIAR a coleção do zero e reindexar tudo.
#
# Padrão: OpenAI text-embedding-3-small (1536 dims, ~US$ 0,02 por 1M de tokens).
# Alternativa: gemini/gemini-embedding-001 (3072 dims) — atenção à quota da
# chave, uma ingestão do acervo inteiro são milhares de chamadas.
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_SIZE=1536

# Banco Relacional — usuários/perfis (Fase 5, RBAC & Governança)
# POSTGRES_HOST=postgres para os containers; localhost se rodar script fora do Docker
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pu_matcher
POSTGRES_USER=pu_matcher
POSTGRES_PASSWORD=

# Segredo de Sessão — assina os tokens de login (Fase 5, tarefa 3). Gere com:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Active Directory / LDAP — OPCIONAL. Sem LDAP_SERVER, a aplicação funciona
# normalmente, só sem a opção de vincular usuário ao AD.
# A conta de bind precisa apenas de LEITURA no diretório; não crie/eleve nada
# por causa desta integração.
LDAP_SERVER=
LDAP_DOMAIN=empresa.local
LDAP_BASE_DN=DC=empresa,DC=local
LDAP_BIND_USER=conta.servico@empresa.local
LDAP_BIND_PASSWORD=
# 636 = LDAPS (padrão). Em 389 a senha do usuário trafega em TEXTO CLARO.
LDAP_PORT=636
LDAP_USE_SSL=true
# Ligue quando a CA interna estiver no truststore da imagem do backend.
LDAP_VALIDAR_CERTIFICADO=false
