# Banco Vetorial Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Chaves de API das IAs (preencher com valores reais em .env local, nunca commitar)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=

# Motor local (Ollama) — alternativa gratuita/sem limite de quota aos provedores acima
# http://host.docker.internal:11434 para os containers falarem com o Ollama do host;
# se for rodar um script direto no host (fora do Docker), use http://localhost:11434
OLLAMA_API_BASE=http://host.docker.internal:11434

# Modelo de embedding usado no RAG (ingestão + busca) — precisa ser o MESMO nos dois momentos
# Padrão: Gemini (gemini/gemini-embedding-001, 3072 dims). Para usar Ollama local:
# EMBEDDING_MODEL=ollama/nomic-embed-text
# VECTOR_SIZE=768
EMBEDDING_MODEL=gemini/gemini-embedding-001
VECTOR_SIZE=3072

# Segredo de Sessão
SECRET_KEY=
