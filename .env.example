# Banco Vetorial Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Nome da coleção. Só mexa se estiver restaurando um snapshot que veio com
# outro nome (o Qdrant cria a coleção com o nome de ORIGEM e não renomeia), ou
# se dividir a mesma instância com outro projeto. Nome errado aqui não dá erro:
# a aplicação simplesmente reporta "base vetorial vazia".
COLLECTION_NAME=pu_products_catalog

# Chaves de API das IAs (preencher com valores reais em .env local, nunca commitar)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=

# Modelo de embedding usado no RAG (ingestão + busca).
#
# TEM QUE SER O MESMO na ingestão e na consulta, e VECTOR_SIZE tem que bater com
# a dimensão do modelo: trocar de modelo NÃO é editar uma variável — muda a
# dimensão do vetor e obriga a RECRIAR a coleção do zero e reindexar tudo.
#
# Padrão: OpenAI text-embedding-3-small (1536 dims, ~US$ 0,02 por 1M de tokens).
# Alternativa: gemini/gemini-embedding-001 (3072 dims) — atenção à quota da
# chave, uma ingestão do acervo inteiro são milhares de chamadas.
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_SIZE=1536

# Tradução da pergunta leiga para o vocabulário do acervo (query expansion)
# ------------------------------------------------------------------------
# Quem pergunta "tem cola pra colchão?" não bate em nada na busca textual: o
# boletim escreve "adesivo" e "espuma flexível". Antes de buscar, uma chamada
# curta ao LLM traduz a pergunta para os termos que existem nos documentos.
# Os termos SOMAM à pergunta original, nunca a substituem, e só entram quando a
# pergunta NÃO cita código de produto nem nome de seção (nesses casos a
# recuperação exata já é mais confiável). Ver backend/app/rag/query_expansion.py.
#
# Deixe em "false" para comparar o motor com e sem tradução sobre as MESMAS
# perguntas — é a forma de medir o efeito sem reverter código.
EXPANSAO_CONSULTA_ATIVA=true
# Vazio ou ausente = usa o primeiro modelo da allowlist (gpt-4o-mini). A
# tradução é curta e barata; não há motivo para gastar o modelo caro nem para
# acoplá-la ao modelo que o usuário escolheu na tela.
# ATENÇÃO: como este modelo é fixo, o TEXTO DA PERGUNTA vai para este provedor
# mesmo quando o usuário escolheu outro na tela. Só a pergunta — a tradução não
# enxerga documento nenhum do acervo. Quem precisar de um provedor único para
# tudo define esta variável com o mesmo modelo usado no chat.
# EXPANSAO_CONSULTA_MODELO=gpt-4o-mini
# Cada termo traduzido vira uma busca própria no Qdrant (e pode virar mais de
# uma, por causa das flexões) — este número é o custo da tradução em
# ida-e-volta de rede.
EXPANSAO_MAX_TERMOS=6
# A tradução é síncrona e fica NA FRENTE de toda a recuperação. Sem teto, o
# padrão do litellm é 6000s: um provedor lento penduraria a pergunta do
# vendedor por minutos antes de o fail-open agir.
EXPANSAO_TIMEOUT_SEGUNDOS=8

# Busca por palavra-chave no acervo
# ---------------------------------
# `client.scroll` do Qdrant é PAGINAÇÃO (ordem de ID), não busca por relevância.
# Com um limite fixo por termo, num acervo em que centenas de trechos contêm a
# palavra, voltavam N ARBITRÁRIOS e o trecho certo podia nunca entrar. A
# varredura agora vai até o fim do termo trazendo só IDs, e o payload é buscado
# apenas dos candidatos escolhidos. Ver backend/app/rag/engine.py.
# Todos são ponto de partida para experimento, não valores validados.
BUSCA_TEXTUAL_TETO_IDS_POR_TERMO=4096
BUSCA_TEXTUAL_PAGINA_SCROLL=2048
BUSCA_TEXTUAL_ORCAMENTO_PAYLOADS=60

# Download dos arquivos-fonte citados pelo RAG
# --------------------------------------------
# Raizes permitidas para servir downloads. O endpoint nunca usa caminhos fora
# desta lista. Em Docker, `/app/data/raw_documents` e `/app/data/uploads` ja
# sao volumes locais do projeto; `/mnt/acervo` deve ser montado no backend se o
# Qdrant foi indexado a partir de um compartilhamento de rede/SMB.
RAG_DOWNLOAD_ROOTS=/app/data/raw_documents,/app/data/uploads,/mnt/acervo
# Mapeia prefixos antigos gravados no Qdrant para mounts locais do container,
# evitando varrer o acervo SMB inteiro por nome de arquivo a cada resposta.
# Formato: origem=destino,origem2=destino2
# Exemplo:
# RAG_DOWNLOAD_PATH_ALIASES=//10.1.1.205/flexivel/GRUPOS/Qualidade/Documentação de Produto=/mnt/acervo

# Banco Relacional — usuários/perfis (Fase 5, RBAC & Governança)
# POSTGRES_HOST=postgres para os containers; localhost se rodar script fora do Docker
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pu_matcher
POSTGRES_USER=pu_matcher
POSTGRES_PASSWORD=

# Segredo de Sessão — assina os tokens de login (Fase 5, tarefa 3). Gere com:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Validade da opção "Manter conectado". A conta continua sendo validada no
# banco a cada requisição; desativar o usuário invalida o acesso imediatamente.
REMEMBER_ME_EXPIRE_DAYS=30

# Active Directory / LDAP — OPCIONAL. Sem LDAP_SERVER, a aplicação funciona
# normalmente, só sem a opção de vincular usuário ao AD.
# A conta de bind precisa apenas de LEITURA no diretório; não crie/eleve nada
# por causa desta integração.
LDAP_SERVER=
LDAP_DOMAIN=empresa.local
LDAP_BASE_DN=DC=empresa,DC=local
LDAP_BIND_USER=conta.servico@empresa.local
LDAP_BIND_PASSWORD=
# 636 = LDAPS (padrão). Em 389 a senha do usuário trafega em TEXTO CLARO.
LDAP_PORT=636
LDAP_USE_SSL=true
# Ligue quando a CA interna estiver no truststore da imagem do backend.
LDAP_VALIDAR_CERTIFICADO=false
