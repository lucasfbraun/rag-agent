FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY ./frontend /app/frontend
# Sem isto, [server] enableStaticServing (.streamlit/config.toml) nunca é
# lido dentro do container — Streamlit resolve config relativo ao CWD onde
# "streamlit run" foi chamado (/app), não à pasta do script.
COPY ./.streamlit /app/.streamlit
# O teste do contrato PWA valida também a configuração que serve o Service
# Worker na raiz. A imagem de frontend é o ambiente oficial da suíte, então
# precisa conter esse arquivo de configuração somente-leitura.
COPY ./proxy /app/proxy

EXPOSE 8501

CMD ["streamlit", "run", "frontend/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
